{
  "className": "org.joget.etb.EmailTemplateBuilder",
  "properties": {
    "id": "",
    "name": "",
    "description": "",
    "subject": "Approval needed: #form.request.title#",
    "preheader": "#form.request.requester# is waiting for your decision",
    "backgroundColor": "#e7e5e4",
    "contentBackground": "#ffffff",
    "textColor": "#333333",
    "linkColor": "#0b5641",
    "fontFamily": "Arial, Helvetica, sans-serif",
    "width": "600px",
    "language": "en",
    "contentBorderRadius": "20px",
    "contentShadow": "true"
  },
  "elements": [
    {
      "className": "org.joget.etb.lib.BadgeBlock",
      "properties": {
        "text": "ACTION REQUIRED",
        "shape": "pill",
        "backgroundColor": "#fef3c7",
        "textColor": "#92400e",
        "padding": "32px 32px 0px 32px",
        "fontSize": "11px",
        "size": "44px",
        "bold": "true",
        "spaced": "true",
        "align": "left"
      }
    },
    {
      "className": "org.joget.etb.lib.RowBlock",
      "properties": {
        "padding": "20px 32px 8px 32px",
        "keepSideBySide": "true"
      },
      "elements": [
        {
          "className": "org.joget.etb.lib.ColumnBlock",
          "properties": {
            "width": "18%",
            "verticalAlign": "middle"
          },
          "elements": [
            {
              "className": "org.joget.etb.lib.BadgeBlock",
              "properties": {
                "text": "SL",
                "shape": "circle",
                "backgroundColor": "#0b5641",
                "textColor": "#ffffff",
                "size": "52px",
                "fontSize": "18px",
                "padding": "0px",
                "bold": "true",
                "spaced": "",
                "align": "left"
              }
            }
          ]
        },
        {
          "className": "org.joget.etb.lib.ColumnBlock",
          "properties": {
            "width": "82%",
            "verticalAlign": "middle"
          },
          "elements": [
            {
              "className": "org.joget.etb.lib.TextBlock",
              "properties": {
                "html": "<p style=\"margin:0;\"><strong>#form.request.requester#</strong><br><span style=\"color:#78716c;\">asks for your approval</span></p>",
                "fontSize": "16px",
                "padding": "0px"
              }
            }
          ]
        }
      ]
    },
    {
      "className": "org.joget.etb.lib.TextBlock",
      "properties": {
        "html": "<p style=\"margin:0;line-height:1.1;\"><strong>#form.request.amount#</strong></p>",
        "fontSize": "42px",
        "color": "#1c1917",
        "padding": "12px 32px 0px 32px"
      }
    },
    {
      "className": "org.joget.etb.lib.TextBlock",
      "properties": {
        "html": "<p style=\"margin:4px 0 0 0;\">for #form.request.title#</p>",
        "fontSize": "16px",
        "color": "#57534e",
        "padding": "0px 32px 16px 32px"
      }
    },
    {
      "className": "org.joget.etb.lib.RowBlock",
      "properties": {
        "padding": "0px 26px"
      },
      "elements": [
        {
          "className": "org.joget.etb.lib.ColumnBlock",
          "properties": {
            "padding": "6px"
          },
          "elements": [
            {
              "className": "org.joget.etb.lib.TextBlock",
              "properties": {
                "html": "<div style=\"background-color:#f5f5f4;border-radius:12px;padding:14px;\"><p style=\"margin:0;font-size:11px;letter-spacing:1px;color:#a8a29e;\">NEEDED BY</p><p style=\"margin:4px 0 0 0;\"><strong>#form.request.date#</strong></p></div>",
                "fontSize": "14px",
                "padding": "0px"
              }
            }
          ]
        },
        {
          "className": "org.joget.etb.lib.ColumnBlock",
          "properties": {
            "padding": "6px"
          },
          "elements": [
            {
              "className": "org.joget.etb.lib.TextBlock",
              "properties": {
                "html": "<div style=\"background-color:#f5f5f4;border-radius:12px;padding:14px;\"><p style=\"margin:0;font-size:11px;letter-spacing:1px;color:#a8a29e;\">REASON</p><p style=\"margin:4px 0 0 0;\"><strong>#form.request.reason#</strong></p></div>",
                "fontSize": "14px",
                "padding": "0px"
              }
            }
          ]
        }
      ]
    },
    {
      "className": "org.joget.etb.lib.RowBlock",
      "properties": {
        "padding": "0px 24px",
        "keepSideBySide": "true"
      },
      "elements": [
        {
          "className": "org.joget.etb.lib.ColumnBlock",
          "properties": {},
          "elements": [
            {
              "className": "org.joget.etb.lib.ButtonBlock",
              "properties": {
                "label": "&#10003;&nbsp; Approve",
                "href": "https://example.com",
                "backgroundColor": "#16a34a",
                "borderRadius": "999px",
                "fontSize": "16px",
                "align": "right",
                "padding": "24px 6px"
              }
            }
          ]
        },
        {
          "className": "org.joget.etb.lib.ColumnBlock",
          "properties": {},
          "elements": [
            {
              "className": "org.joget.etb.lib.ButtonBlock",
              "properties": {
                "label": "&#10005;&nbsp; Reject",
                "href": "https://example.com",
                "backgroundColor": "#fee2e2",
                "textColor": "#b91c1c",
                "borderRadius": "999px",
                "fontSize": "16px",
                "align": "left",
                "padding": "24px 6px"
              }
            }
          ]
        }
      ]
    },
    {
      "className": "org.joget.etb.lib.TextBlock",
      "properties": {
        "html": "<p>Or open the request in #appDef.name# to add a comment.</p>",
        "align": "center",
        "fontSize": "13px",
        "color": "#a8a29e",
        "padding": "0px 32px 28px 32px"
      }
    },
    {
      "className": "org.joget.etb.lib.OutsideBlock",
      "properties": {
        "padding": "20px 0px 28px 0px"
      },
      "elements": [
        {
          "className": "org.joget.etb.lib.TextBlock",
          "properties": {
            "html": "<p>You are receiving this because you are an approver in #appDef.name#.</p>",
            "align": "center",
            "fontSize": "12px",
            "color": "#6b7785",
            "padding": "0px 32px"
          }
        }
      ]
    }
  ]
}
