{
  "className": "org.joget.etb.EmailTemplateBuilder",
  "properties": {
    "id": "",
    "name": "",
    "description": "",
    "subject": "Your verification code",
    "preheader": "Use this code to continue. It expires in 10 minutes.",
    "backgroundColor": "#eef2ff",
    "contentBackground": "#ffffff",
    "textColor": "#333333",
    "linkColor": "#4f46e5",
    "fontFamily": "Arial, Helvetica, sans-serif",
    "width": "520px",
    "language": "en",
    "contentBorderRadius": "18px",
    "contentShadow": "true"
  },
  "elements": [
    {
      "className": "org.joget.etb.lib.BadgeBlock",
      "properties": {
        "text": "&#9679;&#9679;&#9679;&#9679;",
        "shape": "circle",
        "backgroundColor": "#eef2ff",
        "textColor": "#4f46e5",
        "size": "64px",
        "fontSize": "16px",
        "spaced": "true",
        "align": "center",
        "padding": "36px 32px 8px 32px",
        "bold": "true"
      }
    },
    {
      "className": "org.joget.etb.lib.TextBlock",
      "properties": {
        "html": "<p style=\"margin:0;\"><strong>Your verification code</strong></p>",
        "align": "center",
        "fontSize": "24px",
        "color": "#1e1b4b",
        "padding": "8px 32px 0px 32px"
      }
    },
    {
      "className": "org.joget.etb.lib.TextBlock",
      "properties": {
        "html": "<p>Hi #currentUser.firstName#, enter this code to reset your password.</p>",
        "align": "center",
        "fontSize": "15px",
        "color": "#6b7280",
        "padding": "4px 40px 12px 40px"
      }
    },
    {
      "className": "org.joget.etb.lib.CalloutBlock",
      "properties": {
        "style": "dashed",
        "icon": "",
        "title": "",
        "text": "#form.reset.code#",
        "code": "true",
        "backgroundColor": "#f5f7ff",
        "accentColor": "#a5b4fc",
        "titleColor": "#312e81",
        "radius": "14px",
        "align": "center",
        "padding": "8px 40px",
        "textColor": "#475569",
        "fontSize": "14px"
      }
    },
    {
      "className": "org.joget.etb.lib.BadgeBlock",
      "properties": {
        "text": "EXPIRES IN 10 MINUTES",
        "shape": "pill",
        "backgroundColor": "#fff7ed",
        "textColor": "#c2410c",
        "align": "center",
        "padding": "16px 32px",
        "fontSize": "11px",
        "size": "44px",
        "bold": "true",
        "spaced": "true"
      }
    },
    {
      "className": "org.joget.etb.lib.TextBlock",
      "properties": {
        "html": "<p>Didn't ask for this? Ignore this email; your password stays the same. We will never ask you for this code.</p>",
        "align": "center",
        "fontSize": "13px",
        "color": "#9ca3af",
        "padding": "0px 48px 32px 48px"
      }
    },
    {
      "className": "org.joget.etb.lib.OutsideBlock",
      "properties": {
        "padding": "20px 0px 28px 0px"
      },
      "elements": [
        {
          "className": "org.joget.etb.lib.TextBlock",
          "properties": {
            "html": "<p>#appDef.name# security</p>",
            "align": "center",
            "fontSize": "12px",
            "color": "#6b7785",
            "padding": "0px 32px"
          }
        }
      ]
    }
  ]
}
