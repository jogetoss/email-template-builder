{
  "element": {
    "className": "org.joget.etb.lib.StepsBlock",
    "properties": {
      "steps": [
        {
          "label": "Submitted",
          "matches": "New, Pending"
        },
        {
          "label": "In review",
          "matches": "Reviewing, In progress"
        },
        {
          "label": "Approved",
          "matches": "Accepted"
        },
        {
          "label": "Done",
          "matches": ""
        }
      ],
      "current": "#form.request.status#",
      "previewStep": "2",
      "lastDone": "true",
      "doneMark": "check",
      "mutedColor": "#e2e8f0",
      "mutedLabelColor": "#94a3b8",
      "fontSize": "12px",
      "padding": "16px 32px"
    }
  }
}
