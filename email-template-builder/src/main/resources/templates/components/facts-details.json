{
  "element": {
    "className": "org.joget.etb.lib.FactsBlock",
    "properties": {
      "facts": [
        {
          "label": "Status",
          "value": "#form.request.status#"
        },
        {
          "label": "Updated by",
          "value": "#form.request.updatedBy#"
        },
        {
          "label": "Needed by",
          "value": "#form.request.date#"
        }
      ],
      "padding": "8px 32px 16px 32px",
      "labelStyle": "caps",
      "valueAlign": "right",
      "labelWidth": "35%",
      "dividers": "true",
      "dividerColor": "#eef2f7",
      "labelColor": "#94a3b8",
      "fontSize": "14px"
    }
  }
}
