<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
      Build-time only: agent-builder's API (compiled against Joget 8, javax) converted to jakarta, so the AI Composer
      classes compile against the signatures they meet on DX 9, which converts agent-builder the same way on install.
      Never embedded or shipped. Built only with the ai-composer profile (see the parent POM).
    -->
    <parent>
        <groupId>org.joget.marketplace</groupId>
        <artifactId>email-template-builder-parent</artifactId>
        <version>9.0-SNAPSHOT</version>
    </parent>
    <artifactId>agent-builder-api-jakarta</artifactId>
    <packaging>jar</packaging>
    <name>agent-builder-api-jakarta (build-time only)</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.transformer</groupId>
                <artifactId>transformer-maven-plugin</artifactId>
                <version>0.5.0</version>
                <extensions>true</extensions>
                <configuration>
                    <rules>
                        <jakartaDefaults>true</jakartaDefaults>
                    </rules>
                    <artifact>
                        <groupId>org.joget.ai.agent</groupId>
                        <artifactId>agent-builder-api</artifactId>
                        <version>${agent-builder.version}</version>
                    </artifact>
                </configuration>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
